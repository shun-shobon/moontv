		"react-dom": "19.3.0",
		"universal-router": "10.0.3",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@resvg/resvg-js": "2.6.2",
		"@shun-shobon/oxfmt-config": "7.1.0",
		"@shun-shobon/oxlint-config": "7.1.0",
		"@storybook/addon-vitest": "10.6.1",
		"@storybook/react-vite": "10.6.1",
		"@tailwindcss/vite": "4.3.3",
