		"@vitest/browser": "5.0.3",
		"@vitest/browser-playwright": "5.0.3",
		"knip": "6.40.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"playwright": "1.64.0",
		"storybook": "10.6.1",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.3"
