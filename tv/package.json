{
	"name": "moontv-tv",
	"version": "0.1.0",
	"private": true,
	"description": "moontv の Google TV アプリ",
	"license": "MIT",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech>",
	"type": "module",
	"main": "index.ts",
	"scripts": {
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prebuild": "EXPO_TV=1 expo prebuild --platform android --no-install",
		"start": "expo start",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@moontv/core": "workspace:*",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-tvos/config-tv": "0.1.7",
		"@tanstack/react-query": "5.104.1",
		"expo": "58.0.16",
		"expo-build-properties": "58.0.11",
		"expo-crypto": "58.0.7",
		"react": "19.3.0",
		"react-native": "npm:react-native-tvos@0.88.0-0"
	},
	"devDependencies": {
		"@shun-shobon/oxfmt-config": "7.1.0",
		"@shun-shobon/oxlint-config": "7.1.0",
		"@tsconfig/strictest": "2.0.8",
		"@types/react": "19.3.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
