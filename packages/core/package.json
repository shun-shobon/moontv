		"@types/node": "24.19.1",
		"@types/react": "19.3.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"react": "19.3.0",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	},
	"peerDependencies": {
		"@tanstack/react-query": "5.104.1",
		"react": "19.3.0"
